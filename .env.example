# ── DairySCM Environment Configuration ──────────────────

# Optional: Custom Database URI (Default is local SQLite 'sqlite:///dairyscm.db')
# Examples:
# DATABASE_URL=sqlite:///dairyscm.db
# DATABASE_URL=postgresql://user:password@localhost:5432/dairyscm

# Optional: Server Port (Default is 5000)
PORT=5000

# ── Watsonx AI Credentials (Optional) ────────────────────
# Leave as default or empty to use built-in analytics engine
WATSONX_PROJECT_ID=your-project-id-here
WATSONX_API_KEY=your-api-key-here
WATSONX_URL=https://us-south.ml.cloud.ibm.com
